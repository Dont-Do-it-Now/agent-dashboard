{
  "description": "Keeps statusLine pointed at the version-agnostic shim. Each SessionStart array element is a matcher group whose own 'hooks' array holds the commands, so the inner nesting is required by the schema rather than redundant.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/ensure-statusline.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-dashboard-events.mjs\" sessionStarted"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-dashboard-events.mjs\" turnStarted"
        }
      ]
    }
    ],
    "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-dashboard-events.mjs\" turnEnded"
        }
      ]
    }
    ],
    "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-dashboard-events.mjs\" sessionEnded"
        }
      ]
    }
    ]
  },
  "modules": [
    "../dist/mod.js"
  ]
}
